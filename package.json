{
  "name": "builder",
  "private": true,
  "version": "0.1.0",
  "description": "An open, easy-to-use 3D modeler for sheds, decks, furniture and small buildings",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "build:kernel": "node scripts/build-kernel.mjs",
    "dev": "npm run build:kernel && vite",
    "build": "npm run build:kernel && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:precache": "node scripts/check-precache.mjs",
    "test": "vitest run",
    "test:kernel": "cargo test --workspace"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
